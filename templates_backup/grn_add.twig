{% extends "layout.twig" %}

{% block content %}
<div class="h-[calc(100vh-theme(spacing.16))] flex flex-col md:flex-row w-full bg-slate-100 overflow-hidden">
    
    <!-- Left Side: Product Selection -->
    <div class="w-full md:w-7/12 lg:w-8/12 flex flex-col h-full bg-slate-50 border-r border-slate-200">
        <div class="p-4 bg-white border-b border-slate-200 flex flex-col gap-4 z-10 shadow-sm">
            <div class="flex items-center gap-3">
                <a href="/grn" class="w-10 h-10 rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-900 flex items-center justify-center transition-colors">
                    <i data-lucide="arrow-left" class="w-5 h-5"></i>
                </a>
                <div>
                    <h2 class="text-xl font-black text-slate-900 tracking-tight flex items-center gap-2">
                        <i data-lucide="package-plus" class="w-6 h-6 text-indigo-600"></i>
                        Receive Stock
                    </h2>
                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Select products to add to GRN</p>
                </div>
            </div>
            
            <div class="relative">
                <i data-lucide="search" class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text" id="productSearch" placeholder="Search by name or scan barcode..." class="w-full pl-11 pr-4 py-3 bg-slate-100 border-none rounded-xl text-slate-900 placeholder-slate-500 focus:ring-2 focus:ring-indigo-500 font-medium outline-none transition-all">
            </div>
        </div>

        <div class="flex-1 overflow-y-auto p-4">
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3" id="productsGrid">
                {% for p in products %}
                <button onclick="addToReceiveList({{ p.id }}, '{{ p.name|escape('js') }}', {{ p.cost_price|default(0) }}, '{{ p.unit|default('PCS') }}')" 
                        class="product-card group relative bg-white border border-slate-200 rounded-2xl p-3 text-left hover:border-indigo-500 hover:shadow-md hover:shadow-indigo-100 transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500 flex flex-col h-full"
                        data-name="{{ p.name|lower }}"
                        data-barcode="{{ p.barcode|lower }}"
                        data-category="{{ p.category_id }}">
                    
                    <div class="flex-1">
                        <h3 class="font-bold text-slate-800 text-sm leading-tight mb-1 group-hover:text-indigo-700 transition-colors">{{ p.name }}</h3>
                        <p class="text-[10px] text-slate-400 mb-2 truncate">{{ p.barcode|default('No Barcode') }}</p>
                    </div>
                    
                    <div class="mt-auto flex justify-between items-end border-t border-slate-100 pt-2">
                        <span class="text-xs font-medium text-slate-500">{{ p.unit|default('PCS') }}</span>
                        <span class="font-black text-indigo-600 text-sm">QAR {{ p.cost_price|number_format(2) }}</span>
                    </div>
                </button>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Right Side: GRN Form & List -->
    <div class="w-full md:w-5/12 lg:w-4/12 flex flex-col h-full bg-white relative shadow-xl z-20">
        <div class="p-4 border-b border-slate-100 bg-slate-50">
            <div class="mb-4">
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Supplier *</label>
                <div class="relative">
                    <i data-lucide="truck" class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <select id="supplierSelect" required class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all font-medium appearance-none bg-white">
                        <option value="">Select Supplier</option>
                        {% for sup in suppliers %}
                        <option value="{{ sup.id }}">{{ sup.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Notes (Optional)</label>
                <input type="text" id="grnNotes" placeholder="Delivery reference, etc." class="w-full px-4 py-2 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
            </div>
        </div>

        <div class="flex-1 overflow-y-auto p-4 bg-slate-50/50" id="receiveListWrapper">
            <div id="emptyListState" class="h-full flex flex-col items-center justify-center text-slate-400">
                <i data-lucide="package-open" class="w-16 h-16 mb-4 text-slate-300"></i>
                <p class="text-lg font-medium text-slate-500">No items added</p>
                <p class="text-sm text-slate-400 mt-1">Select products to begin</p>
            </div>
            
            <div class="space-y-3" id="receiveList">
                <!-- JS Filled -->
            </div>
        </div>

        <div class="p-4 bg-white border-t border-slate-200 shadow-[0_-10px_40px_-15px_rgba(0,0,0,0.1)] z-30">
            <div class="flex justify-between items-center mb-4">
                <span class="text-slate-500 font-medium">Total Amount</span>
                <span class="text-2xl font-black text-indigo-700" id="grnTotal">QAR 0.00</span>
            </div>
            
            <button id="btnSubmitGrn" onclick="submitGrn()" class="w-full py-3.5 bg-indigo-600 text-white font-bold rounded-xl hover:bg-indigo-700 transition-all flex items-center justify-center gap-2 shadow-lg shadow-indigo-200 disabled:opacity-50 disabled:cursor-not-allowed">
                <i data-lucide="check-circle" class="w-5 h-5"></i>
                Confirm Receipt
            </button>
        </div>
    </div>
</div>

<script>
    let receiveItems = [];

    // Search filter
    document.getElementById('productSearch').addEventListener('input', function(e) {
        const term = e.target.value.toLowerCase().trim();
        const cards = document.querySelectorAll('.product-card');
        
        cards.forEach(card => {
            const name = card.dataset.name;
            const barcode = card.dataset.barcode;
            if (name.includes(term) || barcode.includes(term)) {
                card.classList.remove('hidden');
                card.classList.add('flex');
            } else {
                card.classList.add('hidden');
                card.classList.remove('flex');
            }
        });
        
        // Auto add if perfect barcode match (and only 1 visible)
        if (term.length >= 4) {
            const visible = Array.from(cards).filter(c => !c.classList.contains('hidden'));
            if (visible.length === 1 && visible[0].dataset.barcode === term) {
                visible[0].click();
                e.target.value = '';
                e.target.dispatchEvent(new Event('input'));
                e.target.focus();
            }
        }
    });

    function addToReceiveList(id, name, cost, unit) {
        const existing = receiveItems.find(i => i.id === id);
        if (existing) {
            existing.quantity++;
        } else {
            receiveItems.push({ id, name, cost: cost, quantity: 1, unit });
        }
        updateUI();
    }

    function removeItem(index) {
        receiveItems.splice(index, 1);
        updateUI();
    }

    function updateItemCost(index, value) {
        receiveItems[index].cost = parseFloat(value) || 0;
        updateUI(false);
    }

    function updateItemQty(index, value) {
        receiveItems[index].quantity = parseFloat(value) || 0;
        updateUI(false);
    }

    function updateUI(rebuildList = true) {
        const emptyState = document.getElementById('emptyListState');
        const listEl = document.getElementById('receiveList');
        const totalEl = document.getElementById('grnTotal');
        const btnSubmit = document.getElementById('btnSubmitGrn');
        
        if (receiveItems.length === 0) {
            emptyState.classList.remove('hidden');
            listEl.innerHTML = '';
            totalEl.innerText = 'QAR 0.00';
            btnSubmit.disabled = true;
            return;
        }
        
        emptyState.classList.add('hidden');
        btnSubmit.disabled = false;
        
        let total = 0;
        
        if (rebuildList) {
            listEl.innerHTML = '';
            receiveItems.forEach((item, index) => {
                total += item.cost * item.quantity;
                
                listEl.innerHTML += `
                    <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm relative group">
                        <button onclick="removeItem(${index})" class="absolute -top-2 -right-2 w-6 h-6 bg-rose-100 text-rose-600 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity hover:bg-rose-500 hover:text-white shadow-sm z-10">
                            <i data-lucide="x" class="w-3 h-3"></i>
                        </button>
                        
                        <div class="font-bold text-slate-800 text-sm mb-2 pr-4 leading-tight">${item.name}</div>
                        
                        <div class="flex items-center gap-3">
                            <div class="flex-1">
                                <label class="text-[10px] uppercase font-bold text-slate-400 block mb-0.5">Qty (${item.unit})</label>
                                <input type="number" step="0.01" min="0.01" value="${item.quantity}" onchange="updateItemQty(${index}, this.value)" class="w-full px-2 py-1.5 text-sm bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:bg-white outline-none font-medium">
                            </div>
                            <div class="flex-1">
                                <label class="text-[10px] uppercase font-bold text-slate-400 block mb-0.5">Cost Price</label>
                                <input type="number" step="0.01" min="0" value="${item.cost}" onchange="updateItemCost(${index}, this.value)" class="w-full px-2 py-1.5 text-sm bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:bg-white outline-none font-medium text-indigo-700">
                            </div>
                        </div>
                    </div>
                `;
            });
            lucide.createIcons();
        } else {
            receiveItems.forEach(item => {
                total += item.cost * item.quantity;
            });
        }
        
        totalEl.innerText = 'QAR ' + total.toFixed(2);
    }

    async function submitGrn() {
        const supplierSelect = document.getElementById('supplierSelect');
        const supplierId = supplierSelect.value;
        const supplierName = supplierId ? supplierSelect.options[supplierSelect.selectedIndex].text : '';
        const notes = document.getElementById('grnNotes').value.trim();
        const paymentMethod = document.getElementById('grnPaymentMethod').value;
        const btnSubmit = document.getElementById('btnSubmitGrn');
        
        if (!supplierId) {
            showToast('Please select a supplier', 'error');
            supplierSelect.focus();
            return;
        }
        
        if (receiveItems.length === 0) return;
        
        // Validation for zero qty or negative cost
        const invalid = receiveItems.find(i => i.quantity <= 0 || i.cost < 0);
        if (invalid) {
            showToast('Quantities must be greater than 0 and costs cannot be negative.', 'error');
            return;
        }
        
        const confirmed = await showConfirm(`Are you sure you want to confirm this GRN for ${supplierName}?\nThis will increase the stock counts instantly.`);
        if (!confirmed) return;
        
        btnSubmit.disabled = true;
        btnSubmit.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> Processing...';
        lucide.createIcons();
        
        try {
            const res = await fetch('/grn/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    supplier_id: supplierId,
                    supplier_name: supplierName,
                    notes: notes,
                    payment_method: paymentMethod,
                    items: receiveItems
                })
            });
            const data = await res.json();
            
            if (data.success) {
                showToast('GRN processed successfully!', 'success');
                setTimeout(() => window.location.href = '/grn', 1000);
            } else {
                showToast(data.message || 'Error processing GRN', 'error');
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = '<i data-lucide="check-circle" class="w-5 h-5"></i> Confirm Receipt';
                lucide.createIcons();
            }
        } catch (e) {
            showToast('Network error processing GRN', 'error');
            btnSubmit.disabled = false;
            btnSubmit.innerHTML = '<i data-lucide="check-circle" class="w-5 h-5"></i> Confirm Receipt';
            lucide.createIcons();
        }
    }
</script>
{% endblock %}
