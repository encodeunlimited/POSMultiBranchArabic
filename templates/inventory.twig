{% extends "layout.twig" %}

{% block title %}Inventory | MT POS and ERP{% endblock %}
{% block header_title %}Inventory Management{% endblock %}

{% block content %}
<div class="mb-6 flex flex-col md:flex-row md:justify-between md:items-center gap-4">
    <div>
        <p class="text-slate-500 text-sm">{{ __('Track and manage store items and categories.') }}</p>
    </div>
    <div class="flex flex-wrap gap-3">
        {% if current_user.role != 'Cashier' %}
        <button onclick="openModal('manageCategoriesModal')" class="px-4 py-2 border border-slate-200 text-slate-600 rounded-lg hover:bg-slate-50 font-medium flex items-center gap-2 transition-colors shadow-sm text-sm">
            <i data-lucide="folder-plus" class="w-4 h-4"></i>
            {{ __('Manage Categories') }}
        </button>
        <button onclick="openModal('manageUnitsModal')" class="px-4 py-2 border border-slate-200 text-slate-600 rounded-lg hover:bg-slate-50 font-medium flex items-center gap-2 transition-colors shadow-sm text-sm">
            <i data-lucide="ruler" class="w-4 h-4"></i>
            {{ __('Manage Units') }}
        </button>
        <button onclick="openModal('addProductModal')" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium flex items-center gap-2 transition-colors shadow-sm text-sm">
            <i data-lucide="plus" class="w-4 h-4"></i>
            {{ __('Add Product') }}
        </button>
        {% endif %}
    </div>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
    <div class="p-4 border-b border-slate-100 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-slate-50/30">
        <div class="flex flex-col sm:flex-row gap-4 w-full md:flex-1 md:max-w-xl">
            <div class="relative w-full">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="search" class="w-4 h-4 text-slate-400"></i>
                </div>
                <input type="text" id="inventorySearch" placeholder="{{ __('Search products...') }}" class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all text-sm bg-white">
            </div>
        </div>
        <div class="w-full md:w-auto px-4 py-2 border border-slate-200 rounded-lg bg-white flex items-center justify-center md:justify-start gap-2 text-sm text-slate-600 font-medium">
            <i data-lucide="package" class="w-4 h-4 text-indigo-500"></i>
            <span id="inventoryCount">Records: {{ products|length }}</span>
        </div>
    </div>
    {% if products is empty %}
        <div class="p-12 flex flex-col items-center justify-center text-center">
            <i data-lucide="package-open" class="w-12 h-12 text-slate-300 mb-4"></i>
            <p class="text-slate-500 font-medium">{{ __('No products recorded yet. Click "Add Product" to start tracking.') }}</p>
        </div>
    {% else %}
        <div class="overflow-x-auto">
            <table id="inventoryTable" class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 text-xs uppercase text-slate-500 font-semibold border-b border-slate-100">
                    <tr>
                        <th class="px-6 py-4">{{ __('ID') }}</th>
                        <th class="px-6 py-4">{{ __('Product Name') }}</th>
                        <th class="px-6 py-4">{{ __('Category') }}</th>
                        {% if current_user.role != 'Cashier' %}
                        <th class="px-6 py-4">{{ __('Cost Price') }}</th>
                        {% endif %}
                        <th class="px-6 py-4">{{ __('Selling Price') }}</th>
                        <th class="px-6 py-4">{{ __('Unit') }}</th>
                        <th class="px-6 py-4">{{ __('Stock') }}</th>
                        <th class="px-6 py-4">{{ __('Expiry') }}</th>
                        {% if current_user.role != 'Cashier' %}
                        <th class="px-6 py-4">{{ __('Actions') }}</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for product in products %}
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="px-6 py-4 font-medium text-slate-900">#{{ product.id }}</td>
                        <td class="px-6 py-4 text-slate-800">
                            {% set displayName = lang == 'ar' and product.arabic_name ? product.arabic_name : product.name %}
                            {% set secondaryName = lang == 'ar' and product.arabic_name ? product.name : product.arabic_name %}
                            <div class="flex items-center gap-2">
                                <span>{{ displayName }}</span>
                                {% if lang == 'ar' and not product.arabic_name %}
                                <span class="text-[9px] font-bold px-1.5 py-0.5 bg-amber-100 text-amber-700 rounded border border-amber-200 whitespace-nowrap">لا يوجد اسم</span>
                                {% endif %}
                            </div>
                            {% if secondaryName %}
                            <div class="text-xs text-slate-500 font-arabic mt-0.5" {{ lang == 'ar' ? 'dir="ltr"' : 'dir="rtl"' }}>{{ secondaryName }}</div>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4">
                            {% set displayCategory = lang == 'ar' and product.category_arabic_name ? product.category_arabic_name : product.category_name %}
                            <span class="px-2 py-1 bg-slate-100 text-slate-600 rounded-md text-xs font-medium">{{ displayCategory }}</span>
                        </td>
                        {% if current_user.role != 'Cashier' %}
                        <td class="px-6 py-4">QAR {{ product.cost_price|number_format(2) }}</td>
                        {% endif %}
                        <td class="px-6 py-4 font-medium text-slate-900">QAR {{ product.selling_price|number_format(2) }}</td>
                        <td class="px-6 py-4 text-slate-500 text-xs">{{ product.unit|default('PCS') }}</td>
                        <td class="px-6 py-4">
                            {% set bstock = product.branch_stock|default(0) %}
                            {% set bmin = product.branch_min_stock|default(5) %}
                            {% if bstock <= bmin %}
                                <span class="text-rose-600 font-bold flex items-center gap-1">
                                    <i data-lucide="alert-circle" class="w-4 h-4"></i> {{ bstock }}
                                </span>
                            {% else %}
                                <span class="text-emerald-600 font-bold">{{ bstock }}</span>
                            {% endif %}
                        </td>
                        <td class="px-6 py-4">
                            {% if product.expiry_date %}
                                {% set today = "now"|date("Y-m-d") %}
                                {% if product.expiry_date < today %}
                                    <span class="px-2 py-1 bg-rose-100 text-rose-700 rounded-md text-xs font-bold whitespace-nowrap">Expired: {{ product.expiry_date }}</span>
                                {% else %}
                                    <span class="px-2 py-1 bg-slate-100 text-slate-600 rounded-md text-xs font-medium whitespace-nowrap">{{ product.expiry_date }}</span>
                                {% endif %}
                            {% else %}
                                <span class="text-slate-400 text-xs">-</span>
                            {% endif %}
                        </td>
                        {% if current_user.role != 'Cashier' %}
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                            <div class="flex items-center justify-end gap-2">
                                <button onclick="editItem(this, 'addStockModal', '/products/add-stock/{{ product.id }}')" data-item="{{ product|json_encode|e('html_attr') }}" class="p-2 text-slate-400 hover:text-emerald-600 hover:bg-emerald-50 rounded-lg transition-colors" title="{{ __('Add Stock') }}">
                                    <i data-lucide="plus-circle" class="w-4 h-4"></i>
                                </button>
                                <button onclick="editItem(this, 'updatePriceModal', '/products/update-price/{{ product.id }}')" data-item="{{ product|json_encode|e('html_attr') }}" class="p-2 text-slate-400 hover:text-amber-600 hover:bg-amber-50 rounded-lg transition-colors" title="{{ __('Update Price') }}">
                                    <i data-lucide="tag" class="w-4 h-4"></i>
                                </button>
                                <button onclick="editItem(this, 'editProductModal', '/products/edit/{{ product.id }}')" data-item="{{ product|json_encode|e('html_attr') }}" class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors" title="{{ __('Edit Product') }}">
                                    <i data-lucide="edit-2" class="w-4 h-4"></i>
                                </button>
                                <button onclick="openPrintBarcodeModal({{ product.id }}, '{{ product.barcode|default('') }}', '{{ product.name|escape('js') }}', {{ product.selling_price|default(0) }})" class="p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors" title="{{ __('Print Barcode') }}">
                                    <i data-lucide="printer" class="w-4 h-4"></i>
                                </button>
                                <button onclick="deleteItem('/products/delete/{{ product.id }}', 'product')" class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </td>
                        {% endif %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<!-- Modal Templates -->

<template id="manageUnitsModal">
    <div class="flex flex-col h-full max-h-[80vh]">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900">{{ __('Manage Units') }}</h3>
            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <div class="p-6 border-b border-slate-100 bg-slate-50/50">
            <form onsubmit="event.preventDefault(); submitForm(this, '/unit/add')" class="flex flex-col gap-3">
                <div class="flex gap-3">
                    <input type="text" name="name" placeholder="{{ __('New Unit Name (e.g. PCS)...') }}" required class="flex-1 px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                    <button type="submit" class="px-4 py-2 bg-slate-900 text-white font-medium rounded-lg hover:bg-slate-800 transition-colors">
                        {{ __('Add') }}
                    </button>
                </div>
                <label class="flex items-center gap-2 cursor-pointer text-sm text-slate-600">
                    <input type="checkbox" name="allow_fractional" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
                    <span>{{ __('Allow Decimal/Fractional Quantities (e.g., 1.5 KG)') }}</span>
                </label>
            </form>
        </div>
        <div class="p-6 space-y-2 overflow-y-auto">
            {% for unit in units %}
            <div class="flex justify-between items-center p-4 bg-white rounded-xl border border-slate-200 shadow-sm">
                <div>
                    <span class="font-medium text-slate-800">{{ unit.name }}</span>
                    {% if unit.allow_fractional %}
                    <span class="ml-2 text-[10px] font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200">{{ __('Fractional') }}</span>
                    {% endif %}
                </div>
                <button onclick="deleteUnit({{ unit.id }})" class="text-rose-500 hover:text-rose-700 transition-colors p-2 hover:bg-rose-50 rounded-lg">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
            </div>
            {% else %}
                <p class="text-center text-slate-500 text-sm py-4">{{ __('No units found.') }}</p>
            {% endfor %}
        </div>
    </div>
</template>


<template id="addProductModal">
    <div class="flex flex-col">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900">{{ __('Add New Product') }}</h3>
            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <form onsubmit="event.preventDefault(); submitForm(this, '/inventory/add')" class="p-6 space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">{{ __('Product Name') }}</label>
                <input type="text" name="name" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
            </div>
            
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">{{ __('Category') }}</label>
                    <select name="category_id" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all bg-white">
                        <option value="">{{ __('Select Category') }}</option>
                        {% for category in categories %}
                            <option value="{{ category.id }}">{{ lang == 'ar' and category.arabic_name ? category.arabic_name : category.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">{{ __('Barcode (Optional)') }}</label>
                    <input type="text" name="barcode" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all" placeholder="{{ __('Leave empty to auto-generate') }}">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">{{ __('Arabic Name (Optional)') }}</label>
                    <input type="text" name="arabic_name" dir="rtl" placeholder="الاسم بالعربي" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">{{ __('Unit') }}</label>
                                        <select name="unit" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all bg-white">
                        {% for unit in units %}
                            <option value="{{ unit.name }}">{{ unit.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">{{ __('Cost Price (QAR)') }}</label>
                    <input type="number" step="0.01" name="cost_price" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">{{ __('Selling Price (QAR)') }}</label>
                    <input type="number" step="0.01" name="selling_price" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                </div>
            </div>


            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">{{ __('Initial Stock Count') }}</label>
                    <input type="number" name="stock_count" required value="0" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">{{ __('Min Stock Alert') }}</label>
                    <input type="number" name="min_stock" required value="5" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">{{ __('Expiry Date (Optional)') }}</label>
                <input type="date" name="expiry_date" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all bg-white text-slate-700">
            </div>


            <div class="flex justify-end gap-3 pt-4 border-t border-slate-100 mt-6">
                <button type="button" onclick="closeModal()" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 rounded-lg transition-colors">
                    {{ __('Cancel') }}
                </button>
                <button type="submit" class="px-4 py-2 bg-slate-900 text-white text-sm font-medium rounded-lg hover:bg-slate-800 transition-colors flex items-center">
                    <i data-lucide="check" class="w-4 h-4 mr-2"></i> {{ __('Save Product') }}
                </button>
            </div>
        </form>
    </div>
</template>

<template id="manageCategoriesModal">
    <div class="flex flex-col h-full max-h-[80vh]">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900">{{ __('Manage Categories') }}</h3>
            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <div class="p-6 border-b border-slate-100 bg-slate-50/50">
            <form onsubmit="event.preventDefault(); submitForm(this, '/category/add')" class="flex gap-3">
                <input type="text" name="name" placeholder="{{ __('New Category Name...') }}" required class="flex-1 px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                <input type="text" name="arabic_name" placeholder="{{ __('Arabic Name (Optional)') }}" class="flex-1 px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all" dir="auto">
                <button type="submit" class="px-4 py-2 bg-slate-900 text-white font-medium rounded-lg hover:bg-slate-800 transition-colors whitespace-nowrap">
                    {{ __('Add') }}
                </button>
            </form>
        </div>
        <div class="p-6 space-y-2 overflow-y-auto">
            {% for category in categories %}
            <div class="flex flex-col sm:flex-row justify-between sm:items-center p-4 bg-white rounded-xl border border-slate-200 shadow-sm gap-4">
                <div class="flex-1 flex flex-col">
                    <span class="font-medium text-slate-800">{{ category.name }}</span>
                    {% if category.arabic_name %}
                    <span class="text-sm text-slate-500" dir="rtl">{{ category.arabic_name }}</span>
                    {% endif %}
                </div>
                
                <div class="flex gap-2">
                    <button onclick="editCategory(this, {{ category|json_encode|e('html_attr') }})" class="text-indigo-500 hover:text-indigo-700 transition-colors p-2 hover:bg-indigo-50 rounded-lg">
                        <i data-lucide="edit-2" class="w-4 h-4"></i>
                    </button>
                    <button onclick="deleteCategory({{ category.id }})" class="text-rose-500 hover:text-rose-700 transition-colors p-2 hover:bg-rose-50 rounded-lg">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>
            {% else %}
                <p class="text-center text-slate-500 text-sm py-4">{{ __('No categories found.') }}</p>
            {% endfor %}
        </div>
    </div>
</template>

<script>
function editCategory(btn, category) {
    const listContainer = btn.closest('.overflow-y-auto');
    const formContainer = listContainer.previousElementSibling;
    const form = formContainer.querySelector('form');
    
    form.name.value = category.name;
    if(form.arabic_name) form.arabic_name.value = category.arabic_name || '';
    
    // Update the form action
    form.setAttribute('onsubmit', "event.preventDefault(); submitForm(this, '/category/edit/" + category.id + "')");
    form.querySelector('button[type="submit"]').innerText = 'Update';
    
    // Focus the input
    form.name.focus();
}
</script>

