                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Real Cost (QAR)</label>
                    <input type="number" step="0.01" name="real_cost" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-slate-100 mt-6">
                <button type="button" onclick="closeModal()" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 rounded-lg transition-colors">
                    Cancel
                </button>
                <button type="submit" class="px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors flex items-center">
                    <i data-lucide="check" class="w-4 h-4 mr-2"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</template>

<script>
async function cycleRepairStatus(id, currentStatus) {
    const statuses = ['Pending', 'In Progress', 'Completed'];
    let currentIndex = statuses.indexOf(currentStatus);
    if (currentIndex === -1) currentIndex = 0;
    
    const nextStatus = statuses[(currentIndex + 1) % statuses.length];
    
    try {
        const formData = new FormData();
        formData.append('status', nextStatus);

        const response = await fetch('/repairs/update-status/' + id, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: formData
        });
        const data = await response.json();
        if (data.success) {
            window.location.reload();
        } else {
            showToast('Failed to update status', 'error');
        }
    } catch(e) {
        showToast('An error occurred', 'error');
    }
}
</script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        new TailwindDataTable('repairsTable', 'repairsSearch', 'repairsCount');
    });

function printRepairBill(btn) {
    const repair = JSON.parse(btn.dataset.item);
    
    // Show receipt div
    document.getElementById('repair-receipt-container').classList.remove('hidden');
    
    // Populate
    document.getElementById('recDate').innerText = new Date(repair.created_at).toLocaleString();
    document.getElementById('recRef').innerText = 'REP-' + String(repair.id).padStart(4, '0');
    
    document.getElementById('recCustomer').innerText = repair.customer_name;
    document.getElementById('recPhone').innerText = repair.phone;
    
    document.getElementById('recCategory').innerText = repair.category_name || 'N/A';
    document.getElementById('recIssue').innerText = repair.device_issue;
    
    document.getElementById('recWarranty').innerText = repair.warranty || 'No Warranty';
    
    document.getElementById('recCost').innerText = parseFloat(repair.estimated_cost).toFixed(2);
    document.getElementById('recStatus').innerText = repair.status;
    
    // Print
    window.print();
    
    // Hide again
    document.getElementById('repair-receipt-container').classList.add('hidden');
}
</script>
{% endblock %}
