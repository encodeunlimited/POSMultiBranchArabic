{% extends "layout.twig" %}

{% block title %}Repairs | Global Smart{% endblock %}
{% block header_title %}Repair Service Log{% endblock %}

{% block content %}
<!-- Set Warranty Modal -->
<template id="setWarrantyModal">
    <div class="p-6">
        <h3 class="text-lg font-bold text-slate-800 mb-4">Set Repair Warranty</h3>
        <form onsubmit="saveWarranty(event)">
            <input type="hidden" name="id" id="warranty_repair_id">
            
            <div class="mb-4">
                <label class="block text-sm font-medium text-slate-700 mb-2">Customer / Device</label>
                <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-600" id="warranty_info_text">
                </div>
            </div>

            <div class="mb-6">
                <label class="block text-sm font-medium text-slate-700 mb-2">Warranty Period</label>
                <input type="text" name="warranty" id="warranty_input" placeholder="e.g. 1 Week, 1 Month, 6 Months" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all mb-3">
                
                <!-- Quick presets -->
                <div class="flex flex-wrap gap-2 mt-2">
                    <button type="button" onclick="document.getElementById('warranty_input').value='No Warranty'" class="px-3 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs rounded-full transition-colors">None</button>
                    <button type="button" onclick="document.getElementById('warranty_input').value='1 Week'" class="px-3 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs rounded-full transition-colors">1 Week</button>
                    <button type="button" onclick="document.getElementById('warranty_input').value='2 Weeks'" class="px-3 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs rounded-full transition-colors">2 Weeks</button>
                    <button type="button" onclick="document.getElementById('warranty_input').value='1 Month'" class="px-3 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs rounded-full transition-colors">1 Month</button>
                    <button type="button" onclick="document.getElementById('warranty_input').value='3 Months'" class="px-3 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs rounded-full transition-colors">3 Months</button>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-slate-100 mt-6">
                <button type="button" onclick="closeModal()" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 rounded-lg transition-colors">
                    Cancel
                </button>
                <button type="submit" class="px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors flex items-center">
                    <i data-lucide="shield" class="w-4 h-4 mr-2"></i> Save Warranty
                </button>
            </div>
        </form>
    </div>
</template>

<script>
function openWarrantyModal(btn) {
    const repair = JSON.parse(btn.dataset.item);
    openModal('setWarrantyModal');
    
    setTimeout(() => {
        document.getElementById('warranty_repair_id').value = repair.id;
        document.getElementById('warranty_input').value = repair.warranty || '';
        document.getElementById('warranty_info_text').innerText = repair.customer_name + ' - ' + (repair.category_name || 'Device') + ' (' + repair.device_issue + ')';
    }, 50);
}

async function saveWarranty(e) {
    e.preventDefault();
    const id = document.getElementById('warranty_repair_id').value;
    const warranty = document.getElementById('warranty_input').value;
    
    try {
        const formData = new FormData();
        formData.append('warranty', warranty);

        const response = await fetch('/repairs/set-warranty/' + id, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: formData
        });
        
        const data = await response.json();
        if (data.success) {
            window.location.reload();
        } else {
            showToast('Failed to save warranty', 'error');
        }
    } catch(err) {
        showToast('An error occurred', 'error');
    }
}
</script>
<style>
@media print {
    @page { margin: 0; size: 80mm auto; }
    body { margin: 0; padding: 0; }
    body * {
        visibility: hidden;
    }
    #repair-receipt-container, #repair-receipt-container * {
        visibility: visible;
        color: #000 !important;
    }
    #repair-receipt-container {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        max-width: 80mm;
        margin: 0;
        padding: 0;
        box-shadow: none;
        border: none;
        background-color: white;
    }
}
</style>

<!-- Hidden Repair Receipt -->
<div id="repair-receipt-container" class="hidden font-mono bg-white absolute top-0 left-0 w-[80mm] p-2 text-sm z-50 text-slate-900 pb-10">
    <div class="text-center pt-2 pb-2 border-b border-dashed border-slate-300">
        <h2 class="font-bold text-xl uppercase tracking-widest mb-1">Global Smart</h2>
        <p class="text-xs uppercase font-bold">GST ERP & POS - Repairs</p>
        <p class="text-xs mt-1 font-bold" id="recDate"></p>
        <p class="text-[11px] mt-1 font-bold">Contact : 7096 4494</p>
        <p class="text-[11px] mt-1 uppercase font-bold">Ref: <span id="recRef"></span></p>
    </div>
    
    <div class="py-3 border-b border-dashed border-slate-300">
        <div class="flex flex-col gap-1 text-xs mb-2">
            <span class="font-bold uppercase">Customer Details</span>
            <span>Name: <span id="recCustomer"></span></span>
            <span>Phone: <span id="recPhone"></span></span>
        </div>
        
        <div class="flex flex-col gap-1 text-xs">
            <span class="font-bold uppercase mt-2">Device & Issue</span>
            <span>Category: <span id="recCategory"></span></span>
            <span class="whitespace-pre-wrap">Issue: <span id="recIssue"></span></span>
            
            <span class="font-bold uppercase mt-2">Warranty</span>
            <span><span id="recWarranty">None</span></span>
        </div>
    </div>
    
    <div class="py-2 border-b border-dashed border-slate-300 text-xs">
        <div class="flex justify-between font-bold">
            <span>TOTAL ESTIMATED COST</span>
            <span>QAR <span id="recCost">0.00</span></span>
        </div>
        <div class="flex justify-between mt-1 text-slate-900 font-bold">
            <span>Status</span>
            <span id="recStatus">Pending</span>
        </div>
    </div>
    
    <div class="pt-4 text-center pb-8">
        <p class="text-[11px] font-bold uppercase mb-1">Thank you for your business!</p>
        <p class="text-[11px] uppercase font-bold mb-2">Please keep this receipt for warranty claims.</p>
        <div class="border-t border-slate-900 pt-2 leading-tight text-[11px] font-bold">
            Shop No 02, Umm Al Dome Street.<br>Al Muaither
        </div>
    </div>
</div>
<div class="mb-6 flex flex-col md:flex-row md:justify-between md:items-center gap-4">
    <div>
        <p class="text-slate-500 text-sm">Manage customer devices, service costs, and completion status.</p>
    </div>
    <div class="flex flex-wrap gap-3">
        <button onclick="openModal('manageRepairCategoriesModal')" class="px-4 py-2 border border-slate-200 text-slate-600 rounded-lg hover:bg-slate-50 font-medium flex items-center gap-2 transition-colors shadow-sm text-sm">
            <i data-lucide="folder-plus" class="w-4 h-4"></i>
            Categories
        </button>
        <button onclick="openModal('addRepairModal')" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium flex items-center gap-2 transition-colors shadow-sm text-sm">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Log New Repair
        </button>
    </div>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
    <div class="p-4 border-b border-slate-100 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-slate-50/30">
        <div class="flex flex-col sm:flex-row gap-4 w-full md:flex-1 md:max-w-xl">
            <div class="relative w-full">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="search" class="w-4 h-4 text-slate-400"></i>
                </div>
                <input type="text" id="repairsSearch" placeholder="Search by customer name, phone, or issue..." class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all text-sm bg-white">
            </div>
        </div>
        <div class="w-full md:w-auto px-4 py-2 border border-slate-200 rounded-lg bg-white flex items-center justify-center md:justify-start gap-2 text-sm text-slate-600 font-medium mt-4 md:mt-0">
            <i data-lucide="wrench" class="w-4 h-4 text-indigo-500"></i>
            <span id="repairsCount">Records: {{ repairs|length }}</span>
        </div>
    </div>

    {% if repairs is empty %}
        <div class="p-16 flex flex-col items-center justify-center text-center bg-white">
            <i data-lucide="wrench" class="w-12 h-12 text-slate-300 mb-4"></i>
            <p class="text-slate-500 font-medium">No repair records found.</p>
        </div>
    {% else %}
        <div class="overflow-x-auto">
            <table id="repairsTable" class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 text-xs uppercase text-slate-500 font-semibold border-b border-slate-100">
                    <tr>
                        <th class="px-6 py-4">ID & Date</th>
                        <th class="px-6 py-4">Customer Info</th>
                        <th class="px-6 py-4">Category</th>
                        <th class="px-6 py-4">Device & Issue</th>
                        <th class="px-6 py-4">Cost (QAR)</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 bg-white">
                    {% for repair in repairs %}
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="px-6 py-4">
                            <div class="font-bold text-slate-900">#{{ repair.id }}</div>
                            <div class="text-xs text-slate-500">{{ repair.created_at|date("M d, Y") }}</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="font-medium text-slate-900">{{ repair.customer_name }}</div>
                            <div class="text-xs text-slate-500">{{ repair.phone }}</div>
                        </td>
                        <td class="px-6 py-4">
                            <span class="px-2 py-1 bg-slate-100 text-slate-600 rounded-md text-xs font-medium">{{ repair.category_name|default('Uncategorized') }}</span>
                        </td>
                        <td class="px-6 py-4 text-slate-800">{{ repair.device_issue }}</td>
                        <td class="px-6 py-4 font-bold text-slate-900">QAR {{ repair.estimated_cost|number_format(2) }}</td>
                        <td class="px-6 py-4">
                            <span {% if repair.status != 'Completed' %}onclick="cycleRepairStatus({{ repair.id }}, '{{ repair.status }}')" title="Click to cycle status"{% endif %}
                                class="px-2 py-1 rounded-md text-xs font-bold transition-opacity
                                {% if repair.status != 'Completed' %}cursor-pointer hover:opacity-80{% else %}cursor-default{% endif %}
                                {% if repair.status == 'Pending' %}bg-amber-100 text-amber-700
                                {% elseif repair.status == 'Completed' %}bg-emerald-100 text-emerald-700
                                {% else %}bg-slate-100 text-slate-700{% endif %}">
                                {{ repair.status }}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <button onclick="openWarrantyModal(this)" data-item="{{ repair|json_encode|e('html_attr') }}" class="text-amber-600 hover:text-amber-800 p-2 hover:bg-amber-50 rounded-lg transition-colors" title="Set Warranty"><i data-lucide="shield-check" class="w-4 h-4"></i></button>
                                <button onclick="printRepairBill(this)" data-item="{{ repair|json_encode|e('html_attr') }}" class="text-emerald-600 hover:text-emerald-800 p-2 hover:bg-emerald-50 rounded-lg transition-colors" title="Print Bill"><i data-lucide="printer" class="w-4 h-4"></i></button>
                                <button onclick="editItem(this, 'editRepairModal', '/repairs/edit/{{ repair.id }}')" data-item="{{ repair|json_encode|e('html_attr') }}" class="text-indigo-600 hover:text-indigo-800 p-2 hover:bg-indigo-50 rounded-lg transition-colors" title="Edit Repair">
                                    <i data-lucide="edit" class="w-4 h-4"></i>
                                </button>
                                {% if current_user.role == 'Admin' %}
                                <button onclick="deleteItem('/repairs/delete/{{ repair.id }}', 'repair')" class="text-rose-600 hover:text-rose-800 p-2 hover:bg-rose-50 rounded-lg transition-colors" title="Delete Repair">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

<!-- Modals -->
