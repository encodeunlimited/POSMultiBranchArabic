{% extends "layout.twig" %}

{% block title %}Settings | MT POS and ERP{% endblock %}
{% block header_title %}System Settings{% endblock %}

{% block content %}
<div class="mb-6">
    <p class="text-slate-500 text-sm">Manage your shop details, brand identity, branches, and secure staff accounts.</p>
</div>

<div class="mb-6 flex gap-6 border-b border-slate-200 overflow-x-auto">
    <button onclick="switchTab('identity')" id="tab-identity" class="px-4 py-3 text-sm font-medium text-slate-500 hover:text-slate-700 transition-colors flex items-center gap-2 whitespace-nowrap">
        <i data-lucide="store" class="w-4 h-4"></i> Shop Identity
    </button>
    {% if current_user.role in ['Owner', 'Admin'] %}
    <button onclick="switchTab('branches')" id="tab-branches" class="px-4 py-3 text-sm font-medium text-slate-500 hover:text-slate-700 transition-colors flex items-center gap-2 whitespace-nowrap">
        <i data-lucide="building-2" class="w-4 h-4"></i> Branches
    </button>
    {% endif %}
    <button onclick="switchTab('staff')" id="tab-staff" class="px-4 py-3 text-sm font-medium text-indigo-700 border-b-2 border-indigo-700 flex items-center gap-2 whitespace-nowrap">
        <i data-lucide="users" class="w-4 h-4"></i> Staff Accounts
    </button>
</div>

<!-- Shop Identity Section -->
<div id="section-identity" class="hidden bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden mb-6">
    <div class="p-6 border-b border-slate-100 bg-slate-50/30">
        <h3 class="text-lg font-bold text-slate-900">Shop Identity</h3>
        <p class="text-sm text-slate-500">Manage the details that appear on invoices and system headers.</p>
    </div>
    <form onsubmit="event.preventDefault(); submitForm(this, '/settings/identity')" class="p-6 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Shop Name</label>
                <div class="relative">
                    <input type="text" name="shop_name" value="{{ settings.shop_name }}" required class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i data-lucide="store" class="w-4 h-4 text-slate-400"></i>
                    </div>
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Contact Phone</label>
                <div class="relative">
                    <input type="text" name="shop_phone" value="{{ settings.shop_phone }}" required class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i data-lucide="phone" class="w-4 h-4 text-slate-400"></i>
                    </div>
                </div>
            </div>
            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-slate-700 mb-1">Shop Address</label>
                <div class="relative">
                    <input type="text" name="shop_address" value="{{ settings.shop_address }}" required class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i data-lucide="map-pin" class="w-4 h-4 text-slate-400"></i>
                    </div>
                </div>
            </div>
            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-slate-700 mb-1">Shop Logo URL (Optional)</label>
                <div class="relative">
                    <input type="text" name="shop_logo" value="{{ settings.shop_logo }}" placeholder="https://example.com/logo.png" class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i data-lucide="image" class="w-4 h-4 text-slate-400"></i>
                    </div>
                </div>
                {% if settings.shop_logo %}
                <div class="mt-3">
                    <img src="{{ settings.shop_logo }}" alt="Shop Logo" class="h-16 object-contain rounded border border-slate-200 p-1">
                </div>
                {% endif %}
            </div>
        </div>
        <div class="flex justify-end pt-4 border-t border-slate-100">
            <button type="submit" class="px-6 py-2 bg-indigo-600 text-white font-medium rounded-lg hover:bg-indigo-700 transition-colors flex items-center shadow-sm">
                <i data-lucide="save" class="w-4 h-4 mr-2"></i> Save Changes
            </button>
        </div>
    </form>
</div>

<!-- Branches Management Section -->
{% if current_user.role in ['Owner', 'Admin'] %}
<div id="section-branches" class="hidden bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden mb-6">
    <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 bg-slate-50/30">
        <div>
            <h3 class="text-lg font-bold text-slate-900">Branch Management</h3>
            <p class="text-sm text-slate-500">Add, edit or remove store branches. Each branch has its own stock, cashiers, and sales.</p>
        </div>
        <button onclick="openModal('addBranchModal')" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium flex items-center justify-center gap-2 transition-colors shadow-sm text-sm sm:w-auto">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Add Branch
        </button>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50 text-xs uppercase text-slate-500 font-semibold border-b border-slate-100">
                <tr>
                    <th class="px-6 py-4">ID</th>
                    <th class="px-6 py-4">Branch Name</th>
                    <th class="px-6 py-4">Code</th>
                    <th class="px-6 py-4">Address</th>
                    <th class="px-6 py-4">Phone</th>
                    <th class="px-6 py-4">Status</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {% for branch in branches %}
                <tr class="hover:bg-slate-50/50 transition-colors">
                    <td class="px-6 py-4 font-medium text-slate-900">#{{ branch.id }}</td>
                    <td class="px-6 py-4 text-slate-900 font-bold">
                        <div class="flex items-center gap-2">
                            <i data-lucide="building-2" class="w-4 h-4 text-indigo-500"></i>
                            {{ branch.name }}
                        </div>
                    </td>
                    <td class="px-6 py-4"><span class="font-mono text-xs bg-slate-100 px-2 py-1 rounded">{{ branch.code }}</span></td>
                    <td class="px-6 py-4 text-slate-500">{{ branch.address ?: '—' }}</td>
                    <td class="px-6 py-4 text-slate-500">{{ branch.phone ?: '—' }}</td>
                    <td class="px-6 py-4">
                        {% if branch.is_active %}
                            <span class="px-2 py-1 bg-emerald-50 text-emerald-700 rounded-full text-xs font-bold">Active</span>
                        {% else %}
                            <span class="px-2 py-1 bg-slate-100 text-slate-500 rounded-full text-xs font-bold">Inactive</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 text-right">
                        <button onclick="editItem(this, 'editBranchModal', '/branches/edit/{{ branch.id }}')" data-item="{{ branch|json_encode|e('html_attr') }}" class="text-slate-400 hover:text-indigo-600 p-2 hover:bg-indigo-50 rounded-lg transition-colors" title="Edit">
                            <i data-lucide="pencil" class="w-4 h-4"></i>
                        </button>
                        <button onclick="deleteItem('/branches/delete/{{ branch.id }}', 'branch')" class="text-rose-400 hover:text-rose-600 p-2 hover:bg-rose-50 rounded-lg transition-colors ml-1" title="Delete">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endif %}

<!-- Staff Accounts Section -->
<div id="section-staff" class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
    <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 bg-slate-50/30">
        <div>
            <h3 class="text-lg font-bold text-slate-900">User Access Management</h3>
            <p class="text-sm text-slate-500">Configure administrative and cashier accounts for the system.</p>
        </div>
        <button onclick="openModal('addUserModal')" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium flex items-center justify-center gap-2 transition-colors shadow-sm text-sm sm:w-auto">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Add New Account
        </button>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50 text-xs uppercase text-slate-500 font-semibold border-b border-slate-100">
                <tr>
                    <th class="px-6 py-4">ID</th>
                    <th class="px-6 py-4">Username</th>
                    <th class="px-6 py-4">Access Role</th>
                    <th class="px-6 py-4">Branch</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {% for user in users %}
                <tr class="hover:bg-slate-50/50 transition-colors">
                    <td class="px-6 py-4 font-medium text-slate-900">#{{ user.id }}</td>
                    <td class="px-6 py-4 text-slate-900 font-bold flex items-center gap-2">
                        {{ user.username }}
                        {% if user.role == 'Owner' %}
                            <span class="px-2 py-0.5 bg-amber-100 text-amber-700 rounded text-[10px] font-black uppercase tracking-wider">OWNER</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4">
                        {% if user.role == 'Owner' %}
                            <span class="px-3 py-1 bg-amber-50 text-amber-700 border border-amber-100 rounded-full text-xs font-bold">{{ user.role }}</span>
                        {% elseif user.role == 'Admin' %}
                            <span class="px-3 py-1 bg-indigo-50 text-indigo-700 border border-indigo-100 rounded-full text-xs font-bold">{{ user.role }}</span>
                        {% else %}
                            <span class="px-3 py-1 bg-slate-100 text-slate-700 border border-slate-200 rounded-full text-xs font-bold">{{ user.role }}</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4">
                        {% if user.role == 'Owner' %}
                            <span class="text-xs text-amber-600 font-bold">All Branches</span>
                        {% elseif user.branch_id %}
                            {% for branch in branches %}
                                {% if branch.id == user.branch_id %}
                                    <span class="text-xs font-medium text-slate-700 flex items-center gap-1">
                                        <i data-lucide="building-2" class="w-3 h-3 text-indigo-500"></i>
                                        {{ branch.name }}
                                    </span>
                                {% endif %}
                            {% endfor %}
                        {% else %}
                            <span class="text-xs text-slate-400">Unassigned</span>
                        {% endif %}
                    </td>
                    <td class="px-6 py-4 text-right">
                        <button onclick="editItem(this, 'editUserModal', '/users/edit/{{ user.id }}')" data-item="{{ user|json_encode|e('html_attr') }}" class="text-slate-400 hover:text-indigo-600 p-2 hover:bg-indigo-50 rounded-lg transition-colors" title="Edit">
                            <i data-lucide="pencil" class="w-4 h-4"></i>
                        </button>
                        <button onclick="deleteItem('/users/delete/{{ user.id }}', 'user')" class="text-rose-400 hover:text-rose-600 p-2 hover:bg-rose-50 rounded-lg transition-colors ml-1" title="Delete">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- Add User Modal -->
<template id="addUserModal">
    <div class="flex flex-col">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900">Add New Account</h3>
            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <form onsubmit="event.preventDefault(); submitForm(this, '/users/add')" class="p-6 space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Username</label>
                <div class="relative">
                    <input type="text" name="username" required class="w-full pl-4 pr-10 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                        <i data-lucide="user" class="w-4 h-4 text-slate-400"></i>
                    </div>
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Password</label>
                <div class="relative">
                    <input type="password" name="password" required class="w-full pl-4 pr-10 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                        <i data-lucide="key" class="w-4 h-4 text-slate-400"></i>
                    </div>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Access Role</label>
                <select name="role" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all bg-white" onchange="toggleBranchField(this)">
                    <option value="Cashier">Cashier</option>
                    <option value="Stock Manager">Stock Manager</option>
                    <option value="Admin">Admin (All Branches)</option>
                    {% if current_user.role == 'Owner' %}
                    <option value="Owner">Owner (All Branches)</option>
                    {% endif %}
                </select>
            </div>

            <div id="branch-field-add">
                <label class="block text-sm font-medium text-slate-700 mb-1">Assign to Branch</label>
                <select name="branch_id" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all bg-white">
                    {% for branch in branches %}
                    <option value="{{ branch.id }}">{{ branch.name }} [{{ branch.code }}]</option>
                    {% endfor %}
                </select>
            </div>

            <div class="flex justify-end gap-3 pt-4 border-t border-slate-100 mt-6">
                <button type="button" onclick="closeModal()" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 rounded-lg transition-colors">
                    Cancel
                </button>
                <button type="submit" class="px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors flex items-center">
                    <i data-lucide="check" class="w-4 h-4 mr-2"></i> Create Account
                </button>
            </div>
        </form>
    </div>
</template>

<!-- Edit User Modal -->
<template id="editUserModal">
    <div class="flex flex-col">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900">Edit Account</h3>
            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <form class="p-6 space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Username</label>
                <div class="relative">
                    <input type="text" name="username" required class="w-full pl-4 pr-10 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                        <i data-lucide="user" class="w-4 h-4 text-slate-400"></i>
                    </div>
                </div>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Role</label>
                <select name="role" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all bg-white" onchange="toggleBranchField(this)">
                    <option value="Cashier">Cashier (POS & Basic Inventory)</option>
                    <option value="Admin">Admin (All Branches)</option>
                    <option value="Stock Manager">Stock Manager (Inventory Only)</option>
                    {% if current_user.role == 'Owner' %}
                    <option value="Owner">Owner (All Branches)</option>
                    {% endif %}
                </select>
            </div>

            <div id="branch-field-edit">
                <label class="block text-sm font-medium text-slate-700 mb-1">Assign to Branch</label>
                <select name="branch_id" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all bg-white">
                    {% for branch in branches %}
                    <option value="{{ branch.id }}">{{ branch.name }} [{{ branch.code }}]</option>
                    {% endfor %}
                </select>
            </div>
            
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">New Password <span class="text-xs text-slate-400 font-normal">(Leave blank to keep current)</span></label>
                <div class="relative">
                    <input type="password" name="password" class="w-full pl-4 pr-10 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                        <i data-lucide="lock" class="w-4 h-4 text-slate-400"></i>
                    </div>
                </div>
            </div>
            
            <div class="flex justify-end gap-3 pt-4 border-t border-slate-100 mt-6">
                <button type="button" onclick="closeModal()" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 rounded-lg transition-colors">
                    Cancel
                </button>
                <button type="submit" class="px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors flex items-center">
                    <i data-lucide="check" class="w-4 h-4 mr-2"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</template>

<!-- Add Branch Modal -->
<template id="addBranchModal">
    <div class="flex flex-col">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900">Add New Branch</h3>
            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <form onsubmit="event.preventDefault(); submitForm(this, '/branches/add')" class="p-6 space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Branch Name</label>
                    <input type="text" name="name" required placeholder="e.g. Branch C" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Branch Code</label>
                    <input type="text" name="code" required placeholder="e.g. BR-C" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all font-mono uppercase">
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Address</label>
                <input type="text" name="address" placeholder="Street address" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Phone</label>
                <input type="text" name="phone" placeholder="Contact number" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
            </div>
            <div class="flex justify-end gap-3 pt-4 border-t border-slate-100 mt-6">
                <button type="button" onclick="closeModal()" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 rounded-lg transition-colors">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors flex items-center">
                    <i data-lucide="check" class="w-4 h-4 mr-2"></i> Create Branch
                </button>
            </div>
        </form>
    </div>
</template>

<!-- Edit Branch Modal -->
<template id="editBranchModal">
    <div class="flex flex-col">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900">Edit Branch</h3>
            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <form class="p-6 space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Branch Name</label>
                    <input type="text" name="name" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Branch Code</label>
                    <input type="text" name="code" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all font-mono uppercase">
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Address</label>
                <input type="text" name="address" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Phone</label>
                <input type="text" name="phone" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Status</label>
                <select name="is_active" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all bg-white">
                    <option value="1">Active</option>
                    <option value="0">Inactive</option>
                </select>
            </div>
            <div class="flex justify-end gap-3 pt-4 border-t border-slate-100 mt-6">
                <button type="button" onclick="closeModal()" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 rounded-lg transition-colors">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-lg hover:bg-indigo-700 transition-colors flex items-center">
                    <i data-lucide="check" class="w-4 h-4 mr-2"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</template>

<script>
function switchTab(tab) {
    const tabs = ['identity', 'staff', 'branches'];
    
    tabs.forEach(t => {
        const tabBtn = document.getElementById('tab-' + t);
        const section = document.getElementById('section-' + t);
        
        if (tabBtn) {
            tabBtn.className = 'px-4 py-3 text-sm font-medium text-slate-500 hover:text-slate-700 transition-colors flex items-center gap-2 whitespace-nowrap';
        }
        if (section) {
            section.classList.add('hidden');
        }
    });
    
    const activeTab = document.getElementById('tab-' + tab);
    const activeSection = document.getElementById('section-' + tab);
    
    if (activeTab) {
        activeTab.className = 'px-4 py-3 text-sm font-medium text-indigo-700 border-b-2 border-indigo-700 flex items-center gap-2 whitespace-nowrap';
    }
    if (activeSection) {
        activeSection.classList.remove('hidden');
    }
}

function toggleBranchField(selectEl) {
    const role = selectEl.value;
    const form = selectEl.closest('form');
    const branchFields = form.querySelectorAll('[id^="branch-field"]');
    branchFields.forEach(f => {
        if (role === 'Owner' || role === 'Admin') {
            f.style.display = 'none';
        } else {
            f.style.display = 'block';
        }
    });
}
</script>
{% endblock %}
