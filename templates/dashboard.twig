{% extends "layout.twig" %}

{% block title %}Dashboard | Global Smart{% endblock %}
{% block header_title %}Business Overview{% endblock %}

{% block content %}
<div class="mb-6 flex flex-col md:flex-row md:justify-between md:items-end gap-4">
    <div>
        <p class="text-slate-500 text-sm">Revenue, profit, expenses, and inventory at a glance.</p>
    </div>
    <div class="flex gap-3">
        <form method="GET" action="/" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full md:w-auto">
    <input type="date" name="start_date" value="{{ start_date|default('now'|date('Y-m-01')) }}" class="w-full sm:w-auto px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm" required>
    <span class="text-slate-400 text-sm hidden sm:inline">to</span>
    <input type="date" name="end_date" value="{{ end_date|default('now'|date('Y-m-t')) }}" class="w-full sm:w-auto px-3 py-2 border border-slate-200 rounded-lg text-sm bg-white outline-none focus:ring-2 focus:ring-indigo-500 shadow-sm" required>
    <div class="flex gap-2 w-full sm:w-auto mt-1 sm:mt-0">
        <button type="submit" class="flex-1 sm:flex-none px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-bold shadow-sm hover:bg-indigo-700 transition-colors text-center">
            Filter
        </button>
        {% if start_date %}
        <a href="/" class="flex-1 sm:flex-none px-4 py-2 bg-slate-100 text-slate-600 rounded-lg text-sm font-bold shadow-sm hover:bg-slate-200 transition-colors text-center">
            Clear
        </a>
        {% endif %}
    </div>
</form>
    </div>
</div>

<!-- Metrics Grid -->
{% if current_user.role in ['Admin', 'Owner'] %}
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
    <!-- Revenue -->
    <button onclick="openModal('revenueModal')" class="bg-gradient-to-r from-blue-500 to-indigo-600 rounded-xl p-5 text-white shadow-md relative overflow-hidden text-left hover:scale-[1.02] transition-transform w-full">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-blue-100 mb-1 uppercase">Period Revenue</p>
                <h2 class="text-3xl font-black mb-2">QAR {{ stats.total_revenue|number_format(0) }}</h2>
                <p class="text-[10px] text-blue-200 font-medium">Products: QAR {{ stats.products_revenue|number_format(0) }} | Repairs: QAR {{ stats.repairs_revenue|number_format(0) }}</p>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="bar-chart-2" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </button>

    <!-- Profit -->
    <button onclick="openModal('profitModal')" class="bg-gradient-to-r from-emerald-400 to-emerald-600 rounded-xl p-5 text-white shadow-md relative overflow-hidden text-left hover:scale-[1.02] transition-transform w-full">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-emerald-100 mb-1 uppercase">Period Net Profit</p>
                <h2 class="text-3xl font-black">QAR {{ stats.net_profit|number_format(0) }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="dollar-sign" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </button>

    <!-- Expenses -->
    <button onclick="openModal('expensesModal')" class="bg-gradient-to-r from-slate-700 to-slate-900 rounded-xl p-5 text-white shadow-md relative overflow-hidden text-left hover:scale-[1.02] transition-transform w-full">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-slate-300 mb-1 uppercase">Period Expenses</p>
                <h2 class="text-3xl font-black">QAR {{ stats.total_expenses|number_format(0) }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="trending-down" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </button>

    <!-- Inventory -->
    <button onclick="openModal('inventoryModal')" class="bg-gradient-to-r from-orange-400 to-amber-500 rounded-xl p-5 text-white shadow-md relative overflow-hidden text-left hover:scale-[1.02] transition-transform w-full">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-orange-100 mb-1 uppercase">Total Inventory</p>
                <h2 class="text-3xl font-black">{{ stats.total_inventory }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="package" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </button>

    <!-- Low Stock -->
    <div class="bg-gradient-to-r from-rose-500 to-red-600 rounded-xl p-5 text-white shadow-md relative overflow-hidden">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-rose-100 mb-1 uppercase">Low Stock Items</p>
                <h2 class="text-3xl font-black">{{ stats.low_stock_count }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="alert-triangle" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>

    <!-- Outstanding Dues -->
    <div class="bg-gradient-to-r from-slate-400 to-slate-600 rounded-xl p-5 text-white shadow-md relative overflow-hidden">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-slate-200 mb-1 uppercase">Outstanding Dues</p>
                <h2 class="text-3xl font-black">QAR {{ stats.outstanding_dues|number_format(0) }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="wallet" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>
</div>

{% if current_user.role == 'Owner' and branch_stats is defined and branch_stats|length > 0 %}
<!-- Per-Branch Breakdown -->
<div class="mt-4">
    <h3 class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-3 flex items-center gap-2">
        <i data-lucide="building-2" class="w-4 h-4"></i> Branch Performance
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-{{ branch_stats|length }} gap-4">
        {% for bs in branch_stats %}
        <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <h4 class="font-bold text-slate-900">{{ bs.name }}</h4>
                <span class="text-[10px] font-mono text-slate-400 bg-slate-100 px-2 py-0.5 rounded">{{ bs.code }}</span>
            </div>
            <div class="space-y-2">
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">Revenue</span>
                    <span class="font-bold text-emerald-600">QAR {{ bs.revenue|number_format(0) }}</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">Transactions</span>
                    <span class="font-bold text-slate-700">{{ bs.transactions }}</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-slate-500">Stock Units</span>
                    <span class="font-bold text-indigo-600">{{ bs.stock|number_format(0) }}</span>
                </div>
            </div>
            <div class="mt-3 pt-3 border-t border-slate-100">
                <a href="javascript:switchBranch({{ bs.id }})" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1">
                    <i data-lucide="external-link" class="w-3 h-3"></i> View Branch Details
                </a>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}
{% elseif current_user.role == 'Cashier' %}
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <div class="bg-gradient-to-r from-blue-500 to-indigo-600 rounded-xl p-5 text-white shadow-md relative overflow-hidden">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-blue-100 mb-1 uppercase">Period Sales</p>
                <h2 class="text-3xl font-black">QAR {{ stats.today_sales|number_format(0) }}</h2>
                <p class="text-xs text-blue-200 mt-2">{{ stats.today_transactions }} Transactions</p>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="shopping-bag" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>
    <div class="bg-gradient-to-r from-emerald-400 to-emerald-600 rounded-xl p-5 text-white shadow-md relative overflow-hidden">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-emerald-100 mb-1 uppercase">Period Transactions</p>
                <h2 class="text-3xl font-black">{{ stats.today_transactions }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="calendar" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>
</div>
{% elseif current_user.role == 'Stock Manager' %}
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div class="bg-gradient-to-r from-orange-400 to-amber-500 rounded-xl p-5 text-white shadow-md relative overflow-hidden">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-orange-100 mb-1 uppercase">Total Inventory Items</p>
                <h2 class="text-3xl font-black">{{ stats.total_inventory }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="package" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>
    <div class="bg-gradient-to-r from-indigo-500 to-indigo-700 rounded-xl p-5 text-white shadow-md relative overflow-hidden">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-indigo-100 mb-1 uppercase">Total Stock Value</p>
                <h2 class="text-3xl font-black">QAR {{ stats.inventory_value|number_format(0) }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="dollar-sign" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>
    <div class="bg-gradient-to-r from-rose-500 to-red-600 rounded-xl p-5 text-white shadow-md relative overflow-hidden">
        <div class="relative z-10 flex justify-between items-start">
            <div>
                <p class="text-xs font-bold tracking-wider text-rose-100 mb-1 uppercase">Low Stock Alerts</p>
                <h2 class="text-3xl font-black">{{ stats.low_stock_count }}</h2>
            </div>
            <div class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center backdrop-blur-sm">
                <i data-lucide="alert-triangle" class="w-5 h-5 text-white"></i>
            </div>
        </div>
    </div>
</div>
{% endif %}

<!-- Lower Section -->
{% if current_user.role != 'Cashier' %}
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Action Needed Table -->
    <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 items-start">
            <div class="flex items-center gap-2">
                <i data-lucide="alert-circle" class="w-5 h-5 text-rose-400 shrink-0"></i>
                <h3 class="text-lg font-bold text-slate-900">Immediate Action Needed</h3>
            </div>
            <span class="px-3 py-1 bg-rose-100 text-rose-600 rounded-full text-xs font-black uppercase tracking-wider shrink-0 text-center">Low Stock Alerts</span>
        </div>
        
        {% if low_stock_items is empty %}
        <div class="p-12 flex flex-col items-center justify-center text-center">
            <div class="w-16 h-16 bg-emerald-50 rounded-full flex items-center justify-center mb-4">
                <i data-lucide="check-circle" class="w-8 h-8 text-emerald-500"></i>
            </div>
            <h4 class="text-base font-bold text-slate-900 mb-1">All Stock Levels Optimal</h4>
            <p class="text-sm text-slate-500">No items are currently running low.</p>
        </div>
        {% else %}
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="text-xs text-slate-500 bg-slate-50/50 uppercase font-bold tracking-wider">
                    <tr>
                        <th class="px-6 py-4">Item Name</th>
                        <th class="px-6 py-4">Category</th>
                        <th class="px-6 py-4">Current Stock</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for item in low_stock_items %}
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-6 py-4 font-bold text-slate-900">{{ item.name }}</td>
                        <td class="px-6 py-4 text-slate-500">{{ item.category }}</td>
                        <td class="px-6 py-4">
                            <span class="px-3 py-1 bg-rose-100 text-rose-700 rounded-lg font-bold text-xs">Only {{ item.stock_count }} left</span>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>

    <!-- Right Column (Quick Actions & System Ready) -->
    <div class="space-y-6">
        <!-- Quick Actions -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
            <h3 class="text-lg font-bold text-slate-900 mb-6 flex items-center gap-2">
                <i data-lucide="zap" class="w-5 h-5 text-amber-500"></i>
                Quick Actions
            </h3>
            <div class="space-y-3">
                {% if current_user.role == 'Admin' or current_user.role == 'Stock Manager' %}
            <a href="/inventory#addProductModal" class="w-full flex items-center justify-between p-4 rounded-xl border border-slate-100 hover:border-indigo-200 hover:bg-indigo-50/50 transition-all group block">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-indigo-100 flex items-center justify-center group-hover:bg-indigo-600 transition-colors">
                        <i data-lucide="package-plus" class="w-5 h-5 text-indigo-600 group-hover:text-white transition-colors"></i>
                    </div>
                    <span class="font-bold text-slate-700 group-hover:text-indigo-900">Add Product</span>
                </div>
                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400 group-hover:text-indigo-600"></i>
            </a>
            {% endif %}

                {% if current_user.role == 'Admin' %}
            <a href="/expenses#addExpenseModal" class="w-full flex items-center justify-between p-4 rounded-xl border border-slate-100 hover:border-rose-200 hover:bg-rose-50/50 transition-all group block">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-rose-100 flex items-center justify-center group-hover:bg-rose-600 transition-colors">
                        <i data-lucide="receipt" class="w-5 h-5 text-rose-600 group-hover:text-white transition-colors"></i>
                    </div>
                    <span class="font-bold text-slate-700 group-hover:text-rose-900">Record Expense</span>
                </div>
                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400 group-hover:text-rose-600"></i>
            </a>
            {% endif %}

                {% if current_user.role == 'Admin' %}
            <a href="/repairs#addRepairModal" class="w-full flex items-center justify-between p-4 rounded-xl border border-slate-100 hover:border-amber-200 hover:bg-amber-50/50 transition-all group block">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center group-hover:bg-amber-500 transition-colors">
                        <i data-lucide="wrench" class="w-5 h-5 text-amber-600 group-hover:text-white transition-colors"></i>
                    </div>
                    <span class="font-bold text-slate-700 group-hover:text-amber-900">Log Repair</span>
                </div>
                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400 group-hover:text-amber-500"></i>
            </a>
            {% endif %}
            </div>
        </div>

        <!-- System Ready Card -->
        <div class="bg-slate-900 rounded-2xl shadow-lg border border-slate-800 p-5 flex flex-col items-center justify-center text-center relative overflow-hidden">
            <div class="w-12 h-12 bg-slate-800 rounded-2xl flex items-center justify-center mb-4 shadow-inner">
                <i data-lucide="package" class="w-6 h-6 text-indigo-400"></i>
            </div>
            <h3 class="text-lg font-black text-white mb-1">System Ready</h3>
            <p class="text-slate-400 text-xs mb-5 px-2 leading-relaxed">Your POS terminal and database are perfectly synchronized.</p>
            
            <div class="w-full space-y-2">
                <div class="flex justify-between items-center px-3 py-2 bg-slate-800/50 rounded-lg border border-slate-700/50">
                    <span class="text-xs text-slate-300 font-medium">Database</span>
                    <div class="flex items-center gap-1.5">
                        <div class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></div>
                        <span class="text-[10px] text-emerald-400 font-bold tracking-wider">ONLINE</span>
                    </div>
                </div>
                <div class="flex justify-between items-center px-3 py-2 bg-slate-800/50 rounded-lg border border-slate-700/50">
                    <span class="text-xs text-slate-300 font-medium">Expenses</span>
                    <span class="text-xs text-amber-400 font-bold">QAR {{ stats.total_expenses|number_format(0) }}</span>
                </div>
                <div class="flex justify-between items-center px-4 py-3 bg-slate-800/50 rounded-lg border border-slate-700/50">
                    <span class="text-xs text-slate-300 font-medium">Storage sync</span>
                    <div class="flex items-center gap-1.5">
                        <div class="w-1.5 h-1.5 rounded-full bg-emerald-400"></div>
                        <span class="text-[10px] text-emerald-400 font-bold tracking-wider">SECURE</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}



<!-- Modals for details -->
<template id="inventoryModal">
    <div class="flex flex-col h-full max-h-[80vh]">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded bg-indigo-100 flex items-center justify-center">
                    <i data-lucide="package" class="w-4 h-4 text-indigo-600"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Total Inventory Details</h3>
                    <p class="text-xs text-slate-500">Detailed breakdown of records</p>
                </div>
            </div>
            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <div class="p-6 bg-white flex-1 space-y-3">
            <div class="flex justify-between items-center px-6 py-4 bg-slate-50/50 rounded-xl border border-slate-200/50">
                <span class="text-sm font-bold text-slate-700">Total Stock Items</span>
                <span class="text-sm font-black text-slate-800">{{ stats.total_inventory|number_format(0) }} items</span>
            </div>
            <div class="flex justify-between items-center px-6 py-4 bg-amber-50/50 rounded-xl border border-amber-200/50">
                <span class="text-sm font-bold text-amber-800">Low Stock Alerts</span>
                <span class="text-sm font-black text-amber-900">{{ stats.low_stock_count }} items</span>
            </div>
            <div class="flex justify-between items-center px-6 py-4 bg-rose-50/50 rounded-xl border border-rose-200/50">
                <span class="text-sm font-bold text-rose-800">Outstanding Dues</span>
                <span class="text-sm font-black text-rose-900">QAR {{ stats.outstanding_dues|number_format(0) }}</span>
            </div>
        </div>
        <div class="p-4 border-t border-slate-100 flex justify-end bg-white">
            <button onclick="closeModal()" class="text-sm font-bold text-slate-600 hover:text-slate-900 px-4 py-2">Close Window</button>
        </div>
    </div>
</template>

<template id="expensesModal">
    <div class="flex flex-col h-full max-h-[80vh]">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded bg-indigo-100 flex items-center justify-center">
                    <i data-lucide="trending-down" class="w-4 h-4 text-indigo-600"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Period Expenses Details</h3>
                    <p class="text-xs text-slate-500">Detailed breakdown of records</p>
                </div>
            </div>
            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <div class="p-6 bg-white flex-1 space-y-3">
            <div class="flex justify-between items-center px-6 py-4 bg-rose-50 rounded-xl border border-rose-200 shadow-sm">
                <span class="text-base font-black text-rose-800">Total Period Expenses</span>
                <span class="text-lg font-black text-rose-600">QAR {{ stats.total_expenses|number_format(0) }}</span>
            </div>
            <div class="mt-4 text-center">
                <a href="/expenses" class="text-sm font-medium text-indigo-600 hover:text-indigo-800 underline">View Full Expenses Report</a>
            </div>
        </div>
        <div class="p-4 border-t border-slate-100 flex justify-end bg-white">
            <button onclick="closeModal()" class="text-sm font-bold text-slate-600 hover:text-slate-900 px-4 py-2">Close Window</button>
        </div>
    </div>
</template>
<template id="revenueModal">
    <div class="flex flex-col h-full max-h-[80vh]">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded bg-indigo-100 flex items-center justify-center">
                    <i data-lucide="bar-chart-2" class="w-4 h-4 text-indigo-600"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Period Revenue Details</h3>
                    <p class="text-xs text-slate-500">Detailed breakdown of records</p>
                </div>
            </div>
            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <div class="p-6 bg-white flex-1 space-y-3">
