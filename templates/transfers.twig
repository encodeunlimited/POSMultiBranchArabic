{% extends "layout.twig" %}

{% block content %}
<div class="p-6 max-w-7xl mx-auto">
    
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
                <i data-lucide="arrow-right-left" class="w-8 h-8 text-indigo-600"></i>
                Stock Transfers
            </h1>
            <p class="text-slate-500 text-sm mt-1">Move inventory between branches.</p>
        </div>
        
        <div class="flex items-center gap-3">
            <div class="relative">
                <i data-lucide="search" class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text" id="transferSearch" placeholder="Search Transfers..." class="pl-10 pr-4 py-2 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none w-64 transition-all bg-white">
            </div>
            
            <button onclick="openTransferModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl font-bold flex items-center gap-2 transition-all shadow-lg shadow-indigo-200">
                <i data-lucide="plus" class="w-5 h-5"></i>
                New Transfer
            </button>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left" id="transferTable">
                <thead class="bg-slate-50 text-xs uppercase text-slate-500 font-semibold border-b border-slate-100">
                    <tr>
                        <th class="px-6 py-4">Reference No</th>
                        <th class="px-6 py-4">Date</th>
                        <th class="px-6 py-4">From Branch</th>
                        <th class="px-6 py-4">To Branch</th>
                        <th class="px-6 py-4">Created By</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for trf in transfers %}
                    <tr class="hover:bg-slate-50/50 transition-colors">
                        <td class="px-6 py-4 font-bold text-slate-900">{{ trf.reference_no }}</td>
                        <td class="px-6 py-4 text-slate-500">{{ trf.date|date("Y-m-d h:i A") }}</td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-rose-50 text-rose-700 border border-rose-100">
                                <i data-lucide="log-out" class="w-3 h-3 mr-1"></i> {{ trf.from_branch }}
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-100">
                                <i data-lucide="log-in" class="w-3 h-3 mr-1"></i> {{ trf.to_branch }}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-slate-800">{{ trf.creator|default('System') }}</td>
                        <td class="px-6 py-4 text-right">
                            <button onclick="viewTransfer({{ trf.id }})" class="text-indigo-600 hover:text-indigo-900 font-medium bg-indigo-50 hover:bg-indigo-100 px-3 py-1.5 rounded-lg transition-colors inline-flex items-center gap-1.5">
                                <i data-lucide="eye" class="w-4 h-4"></i> View
                            </button>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="px-6 py-12 text-center text-slate-500">
                            <i data-lucide="arrow-right-left" class="w-12 h-12 mx-auto text-slate-300 mb-3"></i>
                            <p class="text-lg font-medium text-slate-900 mb-1">No Transfers Found</p>
                            <p class="text-sm">There are no stock transfers recorded yet.</p>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex items-center justify-between">
            <span class="text-sm text-slate-500">Showing <span id="transferCount" class="font-bold text-slate-900">{{ transfers|length }}</span> records</span>
        </div>
    </div>
</div>

<!-- View Transfer Modal -->
<div id="viewModal" class="fixed inset-0 bg-slate-900/50 hidden items-center justify-center z-50 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-2xl overflow-hidden flex flex-col max-h-[90vh]">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
            <div>
                <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                    <i data-lucide="arrow-right-left" class="w-5 h-5 text-indigo-600"></i>
                    Transfer Details
                </h3>
                <p id="viewRef" class="text-xs font-bold text-slate-500 mt-0.5">Reference: </p>
            </div>
            <button onclick="closeViewModal()" class="text-slate-400 hover:text-slate-600 transition-colors p-2 hover:bg-slate-200 rounded-lg">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        
        <div class="p-6 overflow-y-auto">
            <div class="grid grid-cols-2 gap-4 mb-6 text-sm">
                <div class="bg-rose-50 p-3 rounded-xl border border-rose-100">
                    <span class="block text-rose-500 text-xs font-bold uppercase mb-1">From Branch</span>
                    <span id="viewFrom" class="font-bold text-rose-900 text-base"></span>
                </div>
                <div class="bg-emerald-50 p-3 rounded-xl border border-emerald-100">
                    <span class="block text-emerald-500 text-xs font-bold uppercase mb-1">To Branch</span>
                    <span id="viewTo" class="font-bold text-emerald-900 text-base"></span>
                </div>
            </div>
            
            <div class="mb-2 text-sm font-bold text-slate-900">Transferred Items</div>
            <div class="border border-slate-200 rounded-xl overflow-hidden">
                <table class="w-full text-sm text-left">
                    <thead class="bg-slate-50 text-xs uppercase text-slate-500 font-semibold border-b border-slate-200">
                        <tr>
                            <th class="px-4 py-3">Product</th>
                            <th class="px-4 py-3 text-center">Unit</th>
                            <th class="px-4 py-3 text-center">Quantity Transferred</th>
                        </tr>
                    </thead>
                    <tbody id="viewItemsList" class="divide-y divide-slate-100">
                        <!-- Filled by JS -->
                    </tbody>
                </table>
            </div>
            
            <div id="viewNotesContainer" class="mt-4 hidden">
                <div class="text-xs font-bold text-slate-500 mb-1">Notes</div>
                <div id="viewNotes" class="text-sm text-slate-700 bg-amber-50 p-3 rounded-xl border border-amber-100"></div>
            </div>
        </div>
    </div>
</div>

<!-- Create Transfer Modal -->
<div id="createModal" class="fixed inset-0 bg-slate-900/50 hidden items-center justify-center z-50 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-4xl overflow-hidden flex flex-col h-[90vh]">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-white z-10">
            <div>
                <h3 class="text-lg font-black text-slate-900 flex items-center gap-2">
                    <i data-lucide="arrow-right-left" class="w-5 h-5 text-indigo-600"></i>
                    New Stock Transfer
                </h3>
                <p class="text-xs font-bold text-slate-500 mt-0.5">Move inventory instantly</p>
            </div>
            <button onclick="closeCreateModal()" class="text-slate-400 hover:text-slate-600 transition-colors p-2 hover:bg-slate-200 rounded-lg">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        
        <div class="flex flex-1 overflow-hidden">
            <!-- Left: Branches & Product Selection -->
            <div class="w-1/2 flex flex-col border-r border-slate-200 bg-slate-50">
                <div class="p-4 bg-white border-b border-slate-200 shadow-sm z-10">
                    <div class="grid grid-cols-2 gap-3 mb-3">
                        <div>
                            <label class="block text-[10px] font-bold text-rose-500 uppercase tracking-wider mb-1">From Branch (Source)</label>
                            <select id="fromBranch" class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-rose-500 outline-none transition-all text-sm font-medium">
                                <option value="">Select Source</option>
                                {% for b in branches %}
                                <option value="{{ b.id }}">{{ b.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-emerald-500 uppercase tracking-wider mb-1">To Branch (Destination)</label>
                            <select id="toBranch" class="w-full px-3 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-emerald-500 outline-none transition-all text-sm font-medium">
                                <option value="">Select Destination</option>
                                {% for b in branches %}
                                <option value="{{ b.id }}">{{ b.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    
                    <div class="relative mt-2">
                        <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="text" id="addSearch" placeholder="Search products..." class="w-full pl-9 pr-3 py-2 bg-slate-100 border-none rounded-lg text-sm text-slate-900 placeholder-slate-500 focus:ring-2 focus:ring-indigo-500 font-medium outline-none transition-all">
                    </div>
                </div>
                
                <div class="flex-1 overflow-y-auto p-3">
                    <div class="space-y-2" id="productsList">
                        {% for p in products %}
                        <div class="add-product-item flex items-center justify-between bg-white p-3 rounded-xl border border-slate-200 hover:border-indigo-300 transition-colors" data-name="{{ p.name|lower }}">
                            <div>
                                <h4 class="font-bold text-slate-800 text-sm leading-tight">{{ p.name }}</h4>
                                <span class="text-xs text-slate-500">{{ p.unit|default('PCS') }}</span>
                            </div>
                            <button onclick="addTransferItem({{ p.id }}, '{{ p.name|escape('js') }}', '{{ p.unit|default('PCS') }}')" class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 hover:bg-indigo-600 hover:text-white flex items-center justify-center transition-colors">
                                <i data-lucide="plus" class="w-4 h-4"></i>
                            </button>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            
            <!-- Right: Selected Items -->
            <div class="w-1/2 flex flex-col bg-white">
                <div class="flex-1 overflow-y-auto p-4 bg-slate-50/50" id="transferItemsWrapper">
                    <div id="emptyTransferState" class="h-full flex flex-col items-center justify-center text-slate-400">
                        <i data-lucide="arrow-right-left" class="w-12 h-12 mb-3 text-slate-300"></i>
                        <p class="text-base font-medium text-slate-500">No items selected</p>
                        <p class="text-xs text-slate-400 mt-1">Select products to transfer</p>
                    </div>
                    
                    <div class="space-y-3" id="transferItemsContainer">
                        <!-- JS Filled -->
                    </div>
                </div>
                
                <div class="p-4 bg-white border-t border-slate-200 shadow-[0_-10px_40px_-15px_rgba(0,0,0,0.1)] z-10">
                    <div class="mb-4">
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Notes (Optional)</label>
                        <input type="text" id="trfNotes" placeholder="Reason for transfer, vehicle no, etc." class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                    </div>
                    
                    <button id="btnSubmitTransfer" onclick="submitTransfer()" class="w-full py-3 bg-indigo-600 text-white font-bold rounded-xl hover:bg-indigo-700 transition-all flex items-center justify-center gap-2 shadow-lg shadow-indigo-200 disabled:opacity-50 disabled:cursor-not-allowed">
                        <i data-lucide="check-circle" class="w-5 h-5"></i>
                        Execute Transfer
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        new TailwindDataTable('transferTable', 'transferSearch', 'transferCount');
    });

    let trfItems = [];

    // Search filter
    document.getElementById('addSearch').addEventListener('input', function(e) {
        const term = e.target.value.toLowerCase().trim();
        const items = document.querySelectorAll('.add-product-item');
        
        items.forEach(item => {
            const name = item.dataset.name;
            if (name.includes(term)) {
                item.classList.remove('hidden');
                item.classList.add('flex');
            } else {
                item.classList.add('hidden');
                item.classList.remove('flex');
            }
        });
    });

    function addTransferItem(id, name, unit) {
        const existing = trfItems.find(i => i.id === id);
        if (existing) {
            existing.quantity++;
        } else {
            trfItems.push({ id, name, quantity: 1, unit });
        }
        updateTrfUI();
    }

    function removeTrfItem(index) {
        trfItems.splice(index, 1);
        updateTrfUI();
    }

    function updateTrfQty(index, value) {
        trfItems[index].quantity = parseFloat(value) || 0;
        updateTrfUI(false);
    }

    function updateTrfUI(rebuild = true) {
        const emptyState = document.getElementById('emptyTransferState');
        const container = document.getElementById('transferItemsContainer');
        const btnSubmit = document.getElementById('btnSubmitTransfer');
        
        if (trfItems.length === 0) {
            emptyState.classList.remove('hidden');
            container.innerHTML = '';
            btnSubmit.disabled = true;
            return;
        }
        
        emptyState.classList.add('hidden');
        btnSubmit.disabled = false;
        
        if (rebuild) {
            container.innerHTML = '';
            trfItems.forEach((item, index) => {
                container.innerHTML += `
                    <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm relative group flex items-center justify-between gap-3">
                        <div class="flex-1">
                            <div class="font-bold text-slate-800 text-sm mb-1 leading-tight">${item.name}</div>
                            <span class="text-xs text-slate-500">${item.unit}</span>
                        </div>
                        <div class="w-24">
                            <input type="number" step="0.01" min="0.01" value="${item.quantity}" onchange="updateTrfQty(${index}, this.value)" class="w-full px-2 py-1.5 text-center font-bold text-sm bg-slate-50 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:bg-white outline-none">
                        </div>
                        <button onclick="removeTrfItem(${index})" class="w-8 h-8 bg-rose-50 text-rose-600 rounded-lg flex items-center justify-center transition-colors hover:bg-rose-500 hover:text-white shrink-0">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </div>
                `;
            });
            lucide.createIcons();
        }
    }

    function openTransferModal() {
        trfItems = [];
        updateTrfUI();
        document.getElementById('fromBranch').value = '';
        document.getElementById('toBranch').value = '';
        document.getElementById('trfNotes').value = '';
        
        document.getElementById('createModal').classList.remove('hidden');
        document.getElementById('createModal').classList.add('flex');
    }

    function closeCreateModal() {
        document.getElementById('createModal').classList.add('hidden');
        document.getElementById('createModal').classList.remove('flex');
    }

    async function submitTransfer() {
        const fromBranch = document.getElementById('fromBranch').value;
        const toBranch = document.getElementById('toBranch').value;
        const notes = document.getElementById('trfNotes').value.trim();
        const btnSubmit = document.getElementById('btnSubmitTransfer');
        
        if (!fromBranch || !toBranch) {
            showToast('Please select both Source and Destination branches', 'error');
            return;
        }
        
        if (fromBranch === toBranch) {
            showToast('Source and Destination branches cannot be the same', 'error');
            return;
        }
        
        if (trfItems.length === 0) return;
        
        const invalid = trfItems.find(i => i.quantity <= 0);
        if (invalid) {
            showToast('Quantities must be greater than 0', 'error');
            return;
        }
        
        const fromName = document.getElementById('fromBranch').options[document.getElementById('fromBranch').selectedIndex].text;
        const toName = document.getElementById('toBranch').options[document.getElementById('toBranch').selectedIndex].text;
        
        const confirmed = await showConfirm(`Are you sure you want to transfer ${trfItems.length} items from ${fromName} to ${toName}?\nThis will update stock counts immediately.`);
        if (!confirmed) return;
        
        btnSubmit.disabled = true;
        btnSubmit.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> Processing...';
        lucide.createIcons();
        
        try {
            const res = await fetch('/transfers/add', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    from_branch_id: fromBranch,
                    to_branch_id: toBranch,
                    notes: notes,
                    items: trfItems
                })
            });
            const data = await res.json();
            
            if (data.success) {
                showToast('Stock transferred successfully!', 'success');
                setTimeout(() => window.location.reload(), 1000);
            } else {
                showToast(data.message || 'Error transferring stock. Ensure source branch has enough stock.', 'error');
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = '<i data-lucide="check-circle" class="w-5 h-5"></i> Execute Transfer';
                lucide.createIcons();
            }
        } catch (e) {
            showToast('Network error processing transfer', 'error');
            btnSubmit.disabled = false;
            btnSubmit.innerHTML = '<i data-lucide="check-circle" class="w-5 h-5"></i> Execute Transfer';
            lucide.createIcons();
        }
    }

    async function viewTransfer(id) {
        try {
            const res = await fetch('/transfers/view/' + id);
            const data = await res.json();
            
            if (data.success) {
                const trf = data.transfer;
                document.getElementById('viewRef').innerText = 'Reference: ' + trf.reference_no;
                document.getElementById('viewFrom').innerText = trf.from_branch;
                document.getElementById('viewTo').innerText = trf.to_branch;
                
                if (trf.notes) {
                    document.getElementById('viewNotesContainer').classList.remove('hidden');
                    document.getElementById('viewNotes').innerText = trf.notes;
                } else {
                    document.getElementById('viewNotesContainer').classList.add('hidden');
                }
                
                const tbody = document.getElementById('viewItemsList');
                tbody.innerHTML = '';
                
                trf.items.forEach(item => {
                    tbody.innerHTML += `
                        <tr class="hover:bg-slate-50">
                            <td class="px-4 py-3 font-medium text-slate-900">${item.product_name}</td>
                            <td class="px-4 py-3 text-center text-slate-500">${item.unit || 'PCS'}</td>
                            <td class="px-4 py-3 text-center font-bold text-indigo-600">${item.quantity}</td>
                        </tr>
                    `;
                });
                
                document.getElementById('viewModal').classList.remove('hidden');
                document.getElementById('viewModal').classList.add('flex');
            } else {
                showToast(data.message, 'error');
            }
        } catch (e) {
            showToast('Failed to load transfer details', 'error');
        }
    }

    function closeViewModal() {
        document.getElementById('viewModal').classList.add('hidden');
        document.getElementById('viewModal').classList.remove('flex');
    }
</script>
{% endblock %}
