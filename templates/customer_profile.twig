{% extends "layout.twig" %}

{% block content %}
<div class="p-6 max-w-7xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <div class="flex items-center gap-3">
                <a href="/customers" class="text-slate-400 hover:text-indigo-600 transition-colors">
                    <i data-lucide="arrow-left" class="w-6 h-6"></i>
                </a>
                <h1 class="text-2xl font-black text-slate-900 tracking-tight">{{ customer.name }}</h1>
            </div>
            <p class="text-slate-500 text-sm mt-1 ml-9">Customer Profile & History</p>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="openPaymentModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl font-bold flex items-center gap-2 transition-all shadow-lg shadow-indigo-200">
                <i data-lucide="wallet" class="w-5 h-5"></i>
                Receive Payment
            </button>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex flex-col justify-center">
            <span class="text-slate-500 font-bold text-xs uppercase tracking-wider mb-1">Contact Info</span>
            <div class="flex items-center gap-2 text-slate-700 font-medium mb-1">
                <i data-lucide="phone" class="w-4 h-4 text-slate-400"></i>
                {{ customer.phone|default('No phone') }}
            </div>
            <div class="flex items-center gap-2 text-slate-700 font-medium text-sm">
                <i data-lucide="mail" class="w-4 h-4 text-slate-400"></i>
                {{ customer.email|default('No email') }}
            </div>
        </div>
        <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex flex-col justify-center">
            <span class="text-slate-500 font-bold text-xs uppercase tracking-wider mb-1">Address</span>
            <div class="flex items-start gap-2 text-slate-700 font-medium text-sm">
                <i data-lucide="map-pin" class="w-4 h-4 text-slate-400 mt-0.5"></i>
                <span class="line-clamp-2">{{ customer.address|default('No address provided') }}</span>
            </div>
        </div>
        <div class="bg-indigo-50 rounded-2xl p-5 border border-indigo-100 shadow-sm flex flex-col justify-center">
            <span class="text-indigo-600 font-bold text-xs uppercase tracking-wider mb-1">Outstanding Balance</span>
            <div class="text-3xl font-black text-indigo-900">QAR {{ customer.balance|number_format(2) }}</div>
        </div>
        <div class="bg-emerald-50 rounded-2xl p-5 border border-emerald-100 shadow-sm flex flex-col justify-center">
            <span class="text-emerald-600 font-bold text-xs uppercase tracking-wider mb-1">Loyalty Points</span>
            <div class="text-3xl font-black text-emerald-900 flex items-center gap-2">
                <i data-lucide="star" class="w-6 h-6 text-emerald-500 fill-emerald-500"></i>
                {{ customer.loyalty_points|default(0) }}
            </div>
        </div>
    </div>

    <!-- History Tabs -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="border-b border-slate-100 flex overflow-x-auto">
            <button onclick="switchTab('sales')" id="tab-sales" class="px-6 py-4 font-bold text-sm text-indigo-600 border-b-2 border-indigo-600 whitespace-nowrap">
                Purchase History
            </button>
            <button onclick="switchTab('payments')" id="tab-payments" class="px-6 py-4 font-bold text-sm text-slate-500 border-b-2 border-transparent hover:text-slate-700 whitespace-nowrap">
                Payment History
            </button>
        </div>

        <!-- Sales Content -->
        <div id="content-sales" class="p-0">
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="bg-slate-50 text-xs uppercase text-slate-500 font-semibold border-b border-slate-100">
                        <tr>
                            <th class="px-6 py-4">Invoice No</th>
                            <th class="px-6 py-4">Date</th>
                            <th class="px-6 py-4">Method</th>
                            <th class="px-6 py-4 text-right">Total</th>
                            <th class="px-6 py-4 text-right">Due (Credit)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for s in sales %}
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4 font-bold text-slate-900">{{ s.invoice_id }}</td>
                            <td class="px-6 py-4 text-slate-600">{{ s.sale_date|date('M d, Y h:i A') }}</td>
                            <td class="px-6 py-4">
                                {% if s.payment_method == 'Credit' %}
                                    <span class="px-2 py-1 bg-amber-100 text-amber-800 rounded text-xs font-bold">{{ s.payment_method }}</span>
                                {% else %}
                                    <span class="px-2 py-1 bg-emerald-100 text-emerald-800 rounded text-xs font-bold">{{ s.payment_method }}</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-right font-bold text-slate-900">QAR {{ s.total|number_format(2) }}</td>
                            <td class="px-6 py-4 text-right text-rose-600 font-bold">{% if s.due > 0 %}QAR {{ s.due|number_format(2) }}{% else %}-{% endif %}</td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-slate-500">
                                No purchases found for this customer.
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Payments Content -->
        <div id="content-payments" class="p-0 hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="bg-slate-50 text-xs uppercase text-slate-500 font-semibold border-b border-slate-100">
                        <tr>
                            <th class="px-6 py-4">Date</th>
                            <th class="px-6 py-4">Method</th>
                            <th class="px-6 py-4">Cashier</th>
                            <th class="px-6 py-4">Notes</th>
                            <th class="px-6 py-4 text-right">Amount Paid</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for p in payments %}
                        <tr class="hover:bg-slate-50/50 transition-colors">
                            <td class="px-6 py-4 text-slate-600 font-medium">{{ p.date|date('M d, Y h:i A') }}</td>
                            <td class="px-6 py-4 text-slate-600">{{ p.payment_method }}</td>
                            <td class="px-6 py-4 text-slate-600">{{ p.cashier_name }}</td>
                            <td class="px-6 py-4 text-slate-500 text-xs">{{ p.notes|default('-') }}</td>
                            <td class="px-6 py-4 text-right font-black text-emerald-600">+ QAR {{ p.amount|number_format(2) }}</td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="5" class="px-6 py-12 text-center text-slate-500">
                                No payments recorded yet.
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Payment Modal -->
<div id="payModal" class="fixed inset-0 bg-slate-900/50 hidden items-center justify-center z-50 backdrop-blur-sm">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md overflow-hidden flex flex-col">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-indigo-50">
            <h3 class="text-lg font-bold text-indigo-900">Receive Payment</h3>
            <button onclick="closePaymentModal()" class="text-indigo-400 hover:text-indigo-600">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <form id="payForm" class="p-6 space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Amount (QAR) *</label>
                <input type="number" step="0.01" max="{{ customer.balance }}" name="amount" id="payAmount" required class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none transition-all text-xl font-bold text-slate-900">
                <p class="text-xs text-slate-500 mt-1">Max outstanding: QAR {{ customer.balance|number_format(2) }}</p>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Payment Method</label>
                <select name="payment_method" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none transition-all">
                    <option value="Cash">Cash</option>
                    <option value="Card">Card</option>
                    <option value="Bank Transfer">Bank Transfer</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Notes (Optional)</label>
                <textarea name="notes" rows="2" class="w-full px-4 py-2 border border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none transition-all"></textarea>
            </div>
            <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
                <button type="button" onclick="closePaymentModal()" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 rounded-lg transition-colors">Cancel</button>
                <button type="submit" id="btnSubmitPay" class="px-4 py-2 text-sm font-bold bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition-colors shadow-md shadow-indigo-200 flex items-center gap-2">
                    <i data-lucide="check-circle" class="w-4 h-4"></i> Confirm Payment
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function switchTab(tab) {
        document.getElementById('content-sales').classList.add('hidden');
        document.getElementById('content-payments').classList.add('hidden');
        
        document.getElementById('tab-sales').className = 'px-6 py-4 font-bold text-sm text-slate-500 border-b-2 border-transparent hover:text-slate-700 whitespace-nowrap';
        document.getElementById('tab-payments').className = 'px-6 py-4 font-bold text-sm text-slate-500 border-b-2 border-transparent hover:text-slate-700 whitespace-nowrap';
        
        document.getElementById('content-' + tab).classList.remove('hidden');
        document.getElementById('tab-' + tab).className = 'px-6 py-4 font-bold text-sm text-indigo-600 border-b-2 border-indigo-600 whitespace-nowrap';
    }

    const payModal = document.getElementById('payModal');
    const payForm = document.getElementById('payForm');

    function openPaymentModal() {
        payForm.reset();
        document.getElementById('payAmount').value = '{{ customer.balance }}';
        payModal.classList.remove('hidden');
        payModal.classList.add('flex');
    }

    function closePaymentModal() {
        payModal.classList.add('hidden');
        payModal.classList.remove('flex');
    }

    payForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('btnSubmitPay');
        btn.disabled = true;
        btn.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin"></i> Processing...';
        
        const formData = new FormData(payForm);
        const data = Object.fromEntries(formData.entries());

        try {
            const res = await fetch('/customers/pay/{{ customer.id }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.success) {
                showToast('Payment recorded successfully!', 'success');
                setTimeout(() => window.location.reload(), 1000);
            } else {
                showToast(result.message || 'Error recording payment', 'error');
                btn.disabled = false;
                btn.innerHTML = '<i data-lucide="check-circle" class="w-4 h-4"></i> Confirm Payment';
                lucide.createIcons();
            }
        } catch (err) {
            showToast('Network error', 'error');
            btn.disabled = false;
        }
    });
</script>
{% endblock %}
